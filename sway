# sway config (~/.config/sway/config)

# Variables
set $hyper Ctrl+Mod4
set $left left
set $right right
set $up up
set $down down

# Exec
exec emacs
exec firefox
exec pipewire
exec pipewire-pulse

# Title Bar
font pango:Iosevka Nerd Font 12
hide_edge_borders smart

# Apps
set $term ghostty
set $menu fuzzel
set $emacs emacs
set $browser firefox
set $finder nautilus

# Window Focus
bindsym $hyper+$left  focus left
bindsym $hyper+$right focus right
bindsym $hyper+$up    focus up
bindsym $hyper+$down  focus down

# Layout
workspace_layout tabbed
bindsym $hyper+t layout tabbed
bindsym $hyper+e layout toggle split
bindsym $hyper+f fullscreen
bindsym $hyper+w kill
bindsym $hyper+c reload
bindsym $hyper+d floating toggle
bindsym $hyper+b splith
bindsym $hyper+v splitv
bindsym $hyper+a focus parent

# Apps
bindsym $hyper+j      exec swaymsg '[app_id="emacs" workspace="__focused__"] focus' || exec $emacs
bindsym $hyper+k      exec swaymsg '[app_id="firefox" workspace="__focused__"] focus' || exec $browser
bindsym $hyper+l      exec swaymsg '[app_id="ghostty" workspace="__focused__"] focus' || exec $term
bindsym $hyper+Space  exec $menu

# Workspaces
bindsym $hyper+1 workspace number 1
bindsym $hyper+2 workspace number 2
bindsym $hyper+3 workspace number 3
bindsym $hyper+4 workspace number 4
bindsym $hyper+5 workspace number 5
bindsym $hyper+6 workspace number 6
bindsym $hyper+7 workspace number 7
bindsym $hyper+8 workspace number 8

# Theme
# class                 border  bg      text    indicator child_border
client.focused          #565f73 #565f73 #ffffff #ffdd33   #565f73
client.focused_inactive #282828 #181818 #95a99f #282828   #282828
client.unfocused        #282828 #181818 #737373 #282828   #282828
client.urgent           #f43841 #3b2022 #ff4f58 #f43841   #f43841
client.placeholder      #101010 #101010 #737373 #101010   #101010
client.background       #181818

# Background
output * bg #181818 solid_color

# Bar
bar {
    position top
    status_command ~/dotfiles/scripts/swaybar-status.sh
    font pango:Iosevka Nerd Font 10

    colors {
        background          #181818
        statusline          #e4e4ef
        separator           #453d41
        focused_workspace   #565f73 #565f73 #ffffff
        active_workspace    #282828 #181818 #e4e4ef
        inactive_workspace  #181818 #181818 #737373
        urgent_workspace    #f43841 #3b2022 #ff4f58
        binding_mode        #ffdd33 #ffdd33 #000000
    }
}

# Gestures
bindgesture swipe:3:left  focus prev
bindgesture swipe:3:right focus next

# Audio Controls (signal the bar to refresh)
set $refresh kill -USR1 $(cat $XDG_RUNTIME_DIR/swaybar-status.pid)
bindsym --locked XF86AudioMute        exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle && $refresh
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && $refresh
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && $refresh
bindsym --locked XF86AudioMicMute     exec wpctl set-mute   @DEFAULT_AUDIO_SOURCE@ toggle

# Brightness Controls
exec brightnessctl set 90%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%- && $refresh
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+ && $refresh

# Screenshot
bindsym Print exec grim ~/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym $hyper+s exec grim -g "$(slurp)" ~/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png

# Keyboard settings
input type:keyboard {
    xkb_layout gb
    xkb_variant mac
    xkb_options altwin:meta_alt
    repeat_rate  36
    repeat_delay 225
}

input "2:1:PS/2_Logitech_Mouse" {
    accel_profile "flat"
    pointer_accel 1.0
    scroll_method on_button_down
    scroll_button 274
}

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    click_method clickfinger
}

include ~/.config/sway/config.local
